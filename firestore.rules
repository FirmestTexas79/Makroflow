rules_version = '2';

// Pravidla Firestore pro Makroflow (docs/adr/0076).
// Nasazení: Firebase konzole → Firestore Database → Rules → vložit a Publikovat
// (nebo `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // Data hráče: číst a zapisovat smí jen on sám.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Promo kódy jen ke čtení (zakládají se ručně v konzoli).
    match /promo_codes/{code} {
      allow read: if request.auth != null;
    }

    // Aréna: duchy čte každý přihlášený, zapisovat smí jen do svého dokumentu.
    // Statistiky Makromonů se neukládají – aplikace je dopočítá z druhu a levelu a data navíc ověří.
    match /arena/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'kind', 'team', 'power', 'updatedAt', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.team is list
        && request.resource.data.team.size() >= 1
        && request.resource.data.team.size() <= 6
        && request.resource.data.power is int
        && request.resource.data.power <= 180;
    }
  }
}

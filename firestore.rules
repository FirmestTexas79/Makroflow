rules_version = '2';

// Pravidla Firestore pro Makroflow. Zdroj pravdy je tenhle soubor (docs/adr/0076);
// nasazení: Firebase konzole → Firestore Database → Rules → vložit celé → Publikovat.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Soukromá data uživatele ──────────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Promo kódy ───────────────────────────────────────────────────
    // Číst může kdokoli přihlášený, zapisovat jen ty přes konzoli
    match /promo_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Uplatněné kódy ───────────────────────────────────────────────
    // Uživatel může zapsat že kód uplatnil, ale už ho nemůže smazat/změnit
    match /redeemed_codes/{userId}/{codeId} {
      allow read, create: if request.auth != null
                          && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // ── Aréna: duchové hráčů (docs/adr/0076) ─────────────────────────
    // Číst může kdokoli přihlášený, zapisovat jen do svého dokumentu a jen
    // ve správném tvaru. Statistiky Makromonů se neukládají – aplikace je
    // dopočítá z druhu a levelu a data navíc sama ověří.
    match /arena/{userId} {
      function shape(d) {
        return d.keys().hasOnly(['name', 'code', 'kind', 'team', 'power', 'updatedAt', 'v', 'points', 'rankedAt'])
          && d.name is string && d.name.size() <= 16
          && d.team is list && d.team.size() >= 1 && d.team.size() <= 6
          && d.power is int && d.power <= 180;
      }
      // body v ranku (docs/adr/0079): beze změny, nebo nejvýš +60 a ne častěji než po 15 s
      function pointsOk() {
        let old = resource.data.get('points', 0);
        let p = request.resource.data.get('points', 0);
        return p is int && p >= 0 && (p == old
          || (p - old <= 60 && request.resource.data.rankedAt == request.time
              && (resource.data.get('rankedAt', null) == null
                  || request.time > resource.data.rankedAt + duration.value(15, 's'))));
      }
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && shape(request.resource.data) && request.resource.data.get('points', 0) == 0;
      allow update: if request.auth != null && request.auth.uid == userId
                    && shape(request.resource.data) && pointsOk();
    }

    // ── Zprávy o obraně ducha (docs/adr/0081) ────────────────────────
    // Vyzyvatel zapíše výsledek souboje proti cizímu duchovi; číst ho smí
    // jen on a majitel ducha, upravovat nikdo, smazat oba.
    match /arena_results/{id} {
      allow read, delete: if request.auth != null
                          && (resource.data.defender == request.auth.uid || resource.data.attacker == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.attacker == request.auth.uid
                    && request.resource.data.defender != request.auth.uid
                    && request.resource.data.keys().hasOnly(['attacker', 'attackerName', 'defender', 'won', 'at'])
                    && request.resource.data.attackerName is string && request.resource.data.attackerName.size() <= 16
                    && request.resource.data.won is bool
                    && request.resource.data.at == request.time;
    }

    // ── Výměny Makromonů (docs/adr/0077) ─────────────────────────────
    // A založí výměnu s nabídkou, B se připojí kódem se svou. Každý smí
    // měnit jen svou část; potvrzenou výměnu (obě strany) už nejde zrušit.
    match /trades/{code} {
      function me() { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function party() { return me() == resource.data.a || me() == resource.data.b; }
      function bothConfirmed() { return resource.data.confirmA == true && resource.data.confirmB == true; }

      // volnou výměnu (bez druhého hráče) přečte každý, kdo zná kód
      allow read: if request.auth != null && (resource.data.b == null || party());

      allow create: if request.auth != null
                    && request.resource.data.a == me()
                    && request.resource.data.b == null
                    && request.resource.data.state == 'open'
                    && request.resource.data.confirmA == false && request.resource.data.confirmB == false
                    && request.resource.data.appliedA == false && request.resource.data.appliedB == false
                    && request.resource.data.keys().hasOnly(['a', 'aName', 'offerA', 'b', 'bName', 'offerB', 'state',
                         'confirmA', 'confirmB', 'appliedA', 'appliedB', 'createdAt', 'v']);

      // připojení druhého hráče s nabídkou
      allow update: if request.auth != null && resource.data.state == 'open' && resource.data.b == null
                    && me() != resource.data.a && request.resource.data.b == me()
                    && request.resource.data.state == 'offered'
                    && changed().hasOnly(['b', 'bName', 'offerB', 'state']);
      // potvrzení vlastní strany
      allow update: if request.auth != null && resource.data.state == 'offered' && me() == resource.data.a
                    && changed().hasOnly(['confirmA']) && request.resource.data.confirmA == true;
      allow update: if request.auth != null && resource.data.state == 'offered' && me() == resource.data.b
                    && changed().hasOnly(['confirmB']) && request.resource.data.confirmB == true;
      // zápis, že si hráč hotovou výměnu provedl u sebe
      allow update: if request.auth != null && bothConfirmed() && me() == resource.data.a
                    && changed().hasOnly(['appliedA']);
      allow update: if request.auth != null && bothConfirmed() && me() == resource.data.b
                    && changed().hasOnly(['appliedB']);
      // zrušení, dokud nepotvrdili oba
      allow update: if request.auth != null && party() && !bothConfirmed() && resource.data.state != 'cancelled'
                    && changed().hasOnly(['state']) && request.resource.data.state == 'cancelled';
      allow delete: if false;
    }

  }
}

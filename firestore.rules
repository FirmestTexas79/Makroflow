rules_version = '2';

// Pravidla Firestore pro Makroflow. Zdroj pravdy je tenhle soubor (docs/adr/0076);
// nasazení: Firebase konzole → Firestore Database → Rules → vložit celé → Publikovat.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Soukromá data uživatele ──────────────────────────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Promo kódy ───────────────────────────────────────────────────
    // Číst může kdokoli přihlášený, zapisovat jen ty přes konzoli
    match /promo_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Uplatněné kódy ───────────────────────────────────────────────
    // Uživatel může zapsat že kód uplatnil, ale už ho nemůže smazat/změnit
    match /redeemed_codes/{userId}/{codeId} {
      allow read, create: if request.auth != null
                          && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // ── Aréna: duchové hráčů (docs/adr/0076) ─────────────────────────
    // Číst může kdokoli přihlášený, zapisovat jen do svého dokumentu a jen
    // ve správném tvaru. Statistiky Makromonů se neukládají – aplikace je
    // dopočítá z druhu a levelu a data navíc sama ověří.
    match /arena/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['name', 'kind', 'team', 'power', 'updatedAt', 'v'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 16
                            && request.resource.data.team is list
                            && request.resource.data.team.size() >= 1
                            && request.resource.data.team.size() <= 6
                            && request.resource.data.power is int
                            && request.resource.data.power <= 180;
    }


    // ── Výměny Makromonů (docs/adr/0077) ─────────────────────────────
    // A založí výměnu s nabídkou, B se připojí kódem se svou. Každý smí
    // měnit jen svou část; potvrzenou výměnu (obě strany) už nejde zrušit.
    match /trades/{code} {
      function me() { return request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function party() { return me() == resource.data.a || me() == resource.data.b; }
      function bothConfirmed() { return resource.data.confirmA == true && resource.data.confirmB == true; }

      // volnou výměnu (bez druhého hráče) přečte každý, kdo zná kód
      allow read: if request.auth != null && (resource.data.b == null || party());

      allow create: if request.auth != null
                    && request.resource.data.a == me()
                    && request.resource.data.b == null
                    && request.resource.data.state == 'open'
                    && request.resource.data.confirmA == false && request.resource.data.confirmB == false
                    && request.resource.data.appliedA == false && request.resource.data.appliedB == false
                    && request.resource.data.keys().hasOnly(['a', 'aName', 'offerA', 'b', 'bName', 'offerB', 'state',
                         'confirmA', 'confirmB', 'appliedA', 'appliedB', 'createdAt', 'v']);

      allow update: if request.auth != null && (
          // připojení druhého hráče s nabídkou
          (resource.data.state == 'open' && resource.data.b == null && me() != resource.data.a
            && request.resource.data.b == me() && request.resource.data.state == 'offered'
            && changed().hasOnly(['b', 'bName', 'offerB', 'state']))
          // potvrzení vlastní strany
          || (resource.data.state == 'offered' && me() == resource.data.a
            && changed().hasOnly(['confirmA']) && request.resource.data.confirmA == true)
          || (resource.data.state == 'offered' && me() == resource.data.b
            && changed().hasOnly(['confirmB']) && request.resource.data.confirmB == true)
          // zápis, že si hráč hotovou výměnu provedl u sebe
          || (bothConfirmed() && me() == resource.data.a && changed().hasOnly(['appliedA']))
          || (bothConfirmed() && me() == resource.data.b && changed().hasOnly(['appliedB']))
          // zrušení, dokud nepotvrdili oba
          || (party() && !bothConfirmed() && resource.data.state != 'cancelled'
            && changed().hasOnly(['state']) && request.resource.data.state == 'cancelled')
      );
      allow delete: if false;
    }

  }
}

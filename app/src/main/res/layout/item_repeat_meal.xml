<?xml version="1.0" encoding="utf-8"?>
<!-- Řádek jídla nebo šablony v „Zopakovat jídlo“ (docs/adr/0027). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_stat_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRepeatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRepeatItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/brand_dark"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRepeatStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRepeatSave"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Uložit jako šablonu"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_line_bookmark"
        app:tint="@color/brand_dark" />

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_line_plus"
        app:tint="@color/brand_cream" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Řádek v Nastavení (docs/adr/0022): ikona, název, popis a vpravo přepínač nebo hodnota. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivSettingIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_primary_alpha10"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="@color/brand_dark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSettingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSettingSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:alpha="0.6"
            android:textColor="@color/brand_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Čas / hodnota (klepnutím se mění) -->
    <TextView
        android:id="@+id/tvSettingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_primary_alpha10"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/brand_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swSetting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivSettingChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/brand_dark_alpha40" />
</LinearLayout>

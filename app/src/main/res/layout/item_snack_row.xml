<?xml version="1.0" encoding="utf-8"?>
<!--
    Řádek potraviny (docs/adr/0021): prstenec s podílem energie z B/S/T, název, porce a makra,
    kcal vpravo a tlačítko „+“ pro okamžité přidání porce (s možností Zpět).
    Klepnutí = vlastní množství, podržení = nabídka (upravit, přesunout, smazat).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/profile_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/brand_dark_alpha12"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <cz.uhk.macroflow.nutrition.MacroDonutView
            android:id="@+id/donutSnack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSnackName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/brand_dark"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSnackMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/brand_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSnackKcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_dark"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:text="kcal"
                android:textColor="@color/brand_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQuickAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_dark"
            android:contentDescription="Přidat porci"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_line_plus"
            app:tint="@color/brand_cream" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

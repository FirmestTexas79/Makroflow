<?xml version="1.0" encoding="utf-8"?>
<!--
    Hlavní obrazovka (docs/adr/0074):
    hlavička s pozdravem podle denní doby a štítky dne → tmavá karta energie (zbývající kcal uprostřed
    tří prstenců maker, legenda se zbytky) → voda a čas tréninku → vláknina a kroky → tip od trenéra
    s výzvou k rituálu → chytrý trenér → metabolický architekt. Karty při otevření postupně vyjedou.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream">

    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-110dp"
        android:alpha="0.06"
        android:importantForAccessibility="no"
        android:rotation="-20"
        android:src="@drawable/bg_monstera_leaf_1"
        app:tint="@color/brand_dark" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="128dp">

        <LinearLayout
            android:id="@+id/dashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Hlavička ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/dashHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="54dp"
                android:paddingEnd="80dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDayIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_line_sun"
                        app:tint="@color/brand_accent_deep" />

                    <TextView
                        android:id="@+id/tvDashDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.14"
                        android:textColor="@color/brand_accent_deep"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUserGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="0.92"
                    android:text="Dobrý den"
                    android:textColor="@color/brand_dark"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvDashSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.75"
                    android:text="Tvůj den v kostce."
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- štítky dne -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:id="@+id/tvTrainingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/brand_dark"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="14dp"
                    android:text="ODPOČINEK"
                    android:textColor="@color/brand_cream"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDashStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/brand_dark_alpha10"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/brand_dark"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Karta energie ────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/cardEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dash_hero"
                android:elevation="10dp"
                android:outlineProvider="background">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-50dp"
                    android:layout_marginEnd="-70dp"
                    android:alpha="0.07"
                    android:importantForAccessibility="no"
                    android:rotation="25"
                    android:src="@drawable/bg_monstera_leaf_2"
                    app:tint="@color/brand_cream" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_line_flame"
                            app:tint="@color/brand_accent_warm" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:letterSpacing="0.16"
                            android:text="ENERGIE DNES"
                            android:textColor="@color/brand_accent_warm"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFoodLog"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="#26FEFAE0"
                            android:clickable="true"
                            android:contentDescription="Co jsem dnes snědl"
                            android:focusable="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Snědeno  ›"
                            android:textColor="@color/brand_cream"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- prstence maker se zbývajícími kaloriemi uprostřed -->
                    <FrameLayout
                        android:layout_width="248dp"
                        android:layout_height="248dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dash_hero_glow"
                            android:importantForAccessibility="no" />

                        <cz.uhk.macroflow.dashboard.MacroRingsView
                            android:id="@+id/ringsMacro"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:includeFontPadding="false"
                                android:text="0"
                                android:textColor="@color/brand_cream"
                                android:textSize="40sp" />

                            <TextView
                                android:id="@+id/tvCaloriesLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.75"
                                android:letterSpacing="0.12"
                                android:text="KCAL ZBÝVÁ"
                                android:textColor="@color/brand_cream"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCaloriesSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="#1FFEFAE0"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/brand_accent_warm"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- legenda: snědeno / cíl a kolik zbývá -->
                    <LinearLayout
                        android:id="@+id/layoutMacros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/DashMacroCol">
                            <TextView style="@style/DashMacroLabel" android:drawableStart="@drawable/dash_dot_p" android:text="BÍLKOVINY" />
                            <TextView android:id="@+id/tvValueProtein" style="@style/DashMacroValue" />
                            <TextView android:id="@+id/tvLeftProtein" style="@style/DashMacroLeft" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="6dp" android:background="#1FFEFAE0" />

                        <LinearLayout style="@style/DashMacroCol">
                            <TextView style="@style/DashMacroLabel" android:drawableStart="@drawable/dash_dot_c" android:text="SACHARIDY" />
                            <TextView android:id="@+id/tvValueCarbs" style="@style/DashMacroValue" />
                            <TextView android:id="@+id/tvLeftCarbs" style="@style/DashMacroLeft" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="6dp" android:background="#1FFEFAE0" />

                        <LinearLayout style="@style/DashMacroCol">
                            <TextView style="@style/DashMacroLabel" android:drawableStart="@drawable/dash_dot_f" android:text="TUKY" />
                            <TextView android:id="@+id/tvValueFat" style="@style/DashMacroValue" />
                            <TextView android:id="@+id/tvLeftFat" style="@style/DashMacroLeft" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ── Voda a čas tréninku ──────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowWaterWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <cz.uhk.macroflow.dashboard.WaterPillView
                    android:id="@+id/waterPillView"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dash_tile_h"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Voda, klepni a přidej"
                    android:focusable="true" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTodayWorkout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dash_tile_h"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Čas dnešního tréninku, klepni a změň"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/brand_dark"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-22dp"
                        android:layout_marginBottom="-26dp"
                        android:alpha="0.08"
                        android:importantForAccessibility="no"
                        android:rotation="-20"
                        android:src="@drawable/ic_ls_lift"
                        app:tint="@color/brand_cream" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:id="@+id/ivWorkoutIcon" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#33E9B072" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/ic_ls_lift" app:tint="@color/brand_accent_warm" />
                            <TextView android:id="@+id/tvWorkoutLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:letterSpacing="0.12" android:text="TRÉNINK" android:textColor="@color/brand_accent_warm" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvTodayWorkoutPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-black" android:text="@string/workout_set_time" android:textColor="@color/brand_cream" android:textSize="22sp" />
                        <TextView android:id="@+id/tvWorkoutSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.7" android:maxLines="1" android:ellipsize="end" android:textColor="@color/brand_cream" android:textSize="11sp" />
                        <ProgressBar android:id="@+id/progressWorkout" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:max="1000" android:progressDrawable="@drawable/progress_dash_workout" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── Vláknina a kroky ─────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/rowFiberSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dash_tile_h"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_tile"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#2E8A9A5B" android:gravity="center" android:importantForAccessibility="no" android:includeFontPadding="false" android:text="🌾" android:textSize="14sp" />
                        <TextView style="@style/DashTileLabel" android:text="VLÁKNINA" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvValueFiber" style="@style/DashTileValue" android:text="0 g" />
                    <ProgressBar
                        android:id="@+id/progressFiber"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_dash_fiber" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dash_tile_h"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_tile"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#2EBC6C25" android:importantForAccessibility="no" android:padding="6dp" android:src="@drawable/ic_ls_walk" app:tint="@color/brand_accent_deep" />
                        <TextView style="@style/DashTileLabel" android:text="KROKY" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvTotalStepsCount" style="@style/DashTileValue" android:text="0" />
                    <TextView android:id="@+id/tvStepsSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:alpha="0.6" android:text="dnes nachozeno" android:textColor="@color/brand_dark" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Tip od trenéra ───────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCoachAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFDF2"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brand_dark_alpha12"
                app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="#33E9B072"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="💡"
                        android:textSize="18sp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="@string/coach_tip_label" android:textColor="@color/brand_accent_deep" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvCoachMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.25" android:text="@string/coach_loading" android:textColor="@color/brand_dark" android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvCoachCta"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_dark"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Ranní rituál  →"
                            android:textColor="@color/brand_cream"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Chytrý trenér ────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/cardStartTraining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dash_train"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:outlineProvider="background">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="-24dp"
                    android:alpha="0.12"
                    android:importantForAccessibility="no"
                    android:rotation="-18"
                    android:src="@drawable/ic_ls_lift"
                    app:tint="@color/brand_cream" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <ImageView android:id="@+id/ivTrainingIcon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#26FEFAE0" android:importantForAccessibility="no" android:padding="11dp" android:src="@drawable/ic_ls_lift" app:tint="@color/brand_cream" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="@string/trainer_smart_label" android:textColor="@color/brand_cream" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:alpha="0.9" android:text="@string/trainer_description" android:textColor="@color/brand_accent_warm" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ivChevron" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_status_pill" android:backgroundTint="@color/brand_accent_warm" android:importantForAccessibility="no" android:padding="7dp" android:src="@drawable/ic_chevron_right" app:tint="@color/brand_dark" />
                </LinearLayout>
            </FrameLayout>

            <!-- ── Metabolický architekt ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/cardArchitect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_dash_tile"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="#2E606C38"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="🧬"
                        android:textSize="18sp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="METABOLICKÝ ARCHITEKT" android:textColor="@color/brand_primary" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvArchitectSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Přesnější cíle z tělesného tuku a stravovacího protokolu" android:textColor="@color/brand_dark" android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEliteMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="Metabolický architekt"
                        android:thumb="@drawable/switch_thumb_custom"
                        android:track="@drawable/switch_track_custom"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:useMaterialThemeColors="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardEliteOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="18dp"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/brand_dark_alpha10" />

                    <!-- tělo: dvě měřené hodnoty jako velká čísla -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                        <LinearLayout style="@style/DashMetricBox" android:layout_marginEnd="5dp">
                            <TextView style="@style/DashMetricLabel" android:text="TĚLESNÝ TUK" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                                <EditText android:id="@+id/etEliteBF" style="@style/DashMetricInput" android:contentDescription="Tělesný tuk v procentech" android:hint="15" />
                                <TextView style="@style/DashMetricUnit" android:text="%" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout style="@style/DashMetricBox" android:layout_marginStart="5dp">
                            <TextView style="@style/DashMetricLabel" android:text="ZÁPĚSTÍ" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                                <EditText android:id="@+id/etEliteWrist" style="@style/DashMetricInput" android:contentDescription="Obvod zápěstí v centimetrech" android:hint="17" />
                                <TextView style="@style/DashMetricUnit" android:text="cm" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- protokol: čipy místo rozbalovacího seznamu -->
                    <TextView style="@style/DashMetricLabel" android:layout_marginTop="16dp" android:text="STRAVOVACÍ PROTOKOL" />
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="-16dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:overScrollMode="never" android:paddingHorizontal="16dp" android:scrollbars="none">
                        <LinearLayout android:id="@+id/llDietChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- rozložení energie jako jeden pruh -->
                    <TextView style="@style/DashMetricLabel" android:layout_marginTop="16dp" android:text="ROZLOŽENÍ ENERGIE" />
                    <LinearLayout android:id="@+id/barMacro" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="8dp" android:background="@drawable/bg_status_pill" android:clipToOutline="true" android:orientation="horizontal">
                        <View android:id="@+id/barProtein" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" android:background="#606C38" />
                        <View android:id="@+id/barCarbs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="45" android:background="#DDA15E" />
                        <View android:id="@+id/barFat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="25" android:background="#BC6C25" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvProteinPct" style="@style/DashPctLegend" android:drawableStart="@drawable/ic_dot_protein" />
                        <TextView android:id="@+id/tvCarbPct" style="@style/DashPctLegend" android:drawableStart="@drawable/ic_dot_carbs" android:gravity="center" />
                        <TextView android:id="@+id/tvFatPct" style="@style/DashPctLegend" android:drawableStart="@drawable/ic_dot_fat" android:gravity="end|center_vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ztmavení za oknem rituálu; klepnutím se okno zavře -->
    <View
        android:id="@+id/ritualScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99283618"
        android:clickable="true"
        android:contentDescription="Zavřít rituál"
        android:focusable="true"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRitualOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/brand_cream"
        app:cardCornerRadius="28dp"
        app:cardElevation="30dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/brand_dark">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content" app:layout_constrainedHeight="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_pill" android:backgroundTint="@color/brand_accent_warm" android:paddingHorizontal="14dp" android:paddingVertical="5dp" android:text="@string/ritual_header" android:textColor="@color/brand_cream" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif-black" android:text="@string/ritual_question" android:textSize="22sp" android:textColor="@color/brand_dark" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:text="@string/ritual_subtitle" android:textSize="13sp" android:textColor="@color/brand_primary" android:alpha="0.8" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ritual_hint_weight" app:suffixText="kg">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCheckInWeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp" android:layout_marginBottom="4dp">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/brand_dark_alpha12" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:text="@string/ritual_status_label" android:textColor="@color/brand_primary" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.14" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/brand_dark_alpha12" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_energy_level" android:textColor="@color/brand_dark" android:textStyle="bold" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderEnergy" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1.0" android:valueTo="5.0" android:stepSize="1.0" app:thumbColor="@color/brand_dark" app:trackColorActive="@color/brand_dark" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_sleep_quality" android:textColor="@color/brand_dark" android:textStyle="bold" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderSleep" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1.0" android:valueTo="5.0" android:stepSize="1.0" app:thumbColor="@color/brand_accent_warm" app:trackColorActive="@color/brand_accent_warm" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_hunger_level" android:textColor="@color/brand_dark" android:textStyle="bold" android:textSize="12sp" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderHunger" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1.0" android:valueTo="5.0" android:stepSize="1.0" app:thumbColor="@color/brand_dark" app:trackColorActive="@color/brand_dark" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveRitual" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="@string/ritual_btn_save" android:textStyle="bold" android:backgroundTint="@color/brand_dark" app:cornerRadius="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <cz.uhk.macroflow.training.GraphicOverlay
        android:id="@+id/graphicOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="54dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_gradient_top_shadow"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#40000000"
            android:src="@drawable/ic_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvDetectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_dark"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/found_training"
            android:textColor="@color/brand_cream"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Výběr cviku -->
    <HorizontalScrollView
        android:id="@+id/liftScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/liftChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Cíl tréninku (VBT): určuje doporučenou zátěž a kdy zazní STOP -->
    <HorizontalScrollView
        android:id="@+id/goalScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/liftScroll">

        <LinearLayout
            android:id="@+id/goalChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Živý panel: počet repů a poslední rep -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="#99283618"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goalScroll">

        <TextView
            android:id="@+id/tvRepCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="0"
            android:textColor="@color/brand_cream"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tvLastRep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="opakování"
            android:textColor="@color/brand_cream"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowRadius="4"
        android:text="Telefon bokem ke čince, 2–3 m daleko, celý kotouč v záběru.\nŤukni na kotouč pro zamčení. Se zátěží spočítám i odhad maxima."
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/inputRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Zátěž a průměr kotouče -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnStartTraining">

        <EditText
            android:id="@+id/etLoad"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#CCFEFAE0"
            android:hint="Zátěž (kg)"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="@color/brand_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPlate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#CCFEFAE0"
            android:hint="Kotouč Ø cm"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:text="45"
            android:textColor="@color/brand_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEndSet"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="10dp"
        android:text="UKONČIT SÉRII"
        android:textColor="@color/white"
        android:visibility="gone"
        app:backgroundTint="#BC6C25"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toTopOf="@id/inputRow"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartTraining"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="120dp"
        android:text="REŽIM: VYPNUTO"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        app:backgroundTint="@color/brand_primary"
        app:cornerRadius="24dp"
        app:elevation="8dp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
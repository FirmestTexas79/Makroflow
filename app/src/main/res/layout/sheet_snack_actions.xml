<?xml version="1.0" encoding="utf-8"?>
<!-- Nabídka po podržení potraviny (docs/adr/0021) – nahrazuje skryté gesto „podrž a táhni doleva“. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_cream"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark_alpha20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">
        <cz.uhk.macroflow.nutrition.MacroDonutView
            android:id="@+id/donutActions"
            android:layout_width="44dp"
            android:layout_height="44dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvActionsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:textColor="@color/brand_dark"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tvActionsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:textColor="@color/brand_dark"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:layout_marginBottom="6dp" android:background="@color/brand_dark_alpha10" />
    <LinearLayout
        android:id="@+id/actConsume"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_primary_alpha10"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_line_plus"
            app:tint="@color/brand_dark" />
        <TextView
            android:id="@+id/actConsumeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Přidat vlastní množství"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/actEdit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_primary_alpha10"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_line_pencil"
            app:tint="@color/brand_dark" />
        <TextView
            android:id="@+id/actEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Upravit potravinu"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/actMove"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_primary_alpha10"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_line_swap"
            app:tint="@color/brand_dark" />
        <TextView
            android:id="@+id/actMoveText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Přesunout"
            android:textColor="@color/brand_dark"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/actDelete"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_primary_alpha10"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_line_trash"
            app:tint="@color/exercise_mistake" />
        <TextView
            android:id="@+id/actDeleteText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Smazat ze špajzky"
            android:textColor="@color/exercise_mistake"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Nabídka „Přidat“ ve Snacích (docs/adr/0021) – nahrazuje čtyři plovoucí tlačítka. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_cream"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark_alpha20" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:text="Přidat jídlo"
        android:textColor="@color/brand_dark"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginBottom="14dp"
        android:alpha="0.75"
        android:text="Jak chceš jídlo zadat?"
        android:textColor="@color/brand_primary"
        android:textSize="13sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addManual"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_pencil"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Nová potravina"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Zadej makra ručně"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addBarcode"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_barcode"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Čárový kód"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Naskenuj obal"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addPhoto"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_camera"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Vyfotit jídlo"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="AI odhad z fotky"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addMeal"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_bowl"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Složit jídlo"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Z více surovin"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addRepeat"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_repeat"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Zopakovat jídlo"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Včerejší snídaně, šablony dnů"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addSwipe"
                    style="@style/ProfileCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginHorizontal="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_primary_alpha10"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_line_cards"
                            app:tint="@color/brand_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Swipe výběr"
                            android:textColor="@color/brand_dark"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:text="Tahem vybírej, co sníst"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>

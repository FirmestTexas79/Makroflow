<?xml version="1.0" encoding="utf-8"?>
<!--
    Trénink podle šablony (docs/adr/0024): cviky dne, u každého model síly (1RM, trend),
    na jakou váhu jsi dnes připraven, minulý trénink a dnešní série.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_cream"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark_alpha20" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/brand_primary"
                    android:letterSpacing="0.12"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="TRÉNINK"
                    android:textColor="@color/brand_cream"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnEditTemplate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Upravit šablonu"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_line_pencil"
                    app:tint="@color/brand_dark" />

                <ImageButton
                    android:id="@+id/btnCloseSession"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zavřít"
                    android:src="@drawable/ic_close"
                    app:tint="@color/brand_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_dark"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tvSessionSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.75"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVariantA"
                    style="@style/ProfileToggleButton"
                    android:layout_height="42dp"
                    android:text="VARIANTA A" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVariantB"
                    style="@style/ProfileToggleButton"
                    android:layout_height="42dp"
                    android:text="VARIANTA B" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/llSessionExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.55"
                android:lineSpacingExtra="1dp"
                android:text="Připravenost = váha pro cílová opakování se 2 v rezervě podle modelu síly (Kalmanův filtr nad odhady 1RM z tvých sérií; pomalé spouštění se přepočítá). Čím víc zápisů, tím přesnější."
                android:textColor="@color/brand_dark"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pauza po sérii podle cviku (docs/adr/0071) – připnutá dole, ať je vidět při scrollování -->
    <LinearLayout
        android:id="@+id/restBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textColor="@color/brand_accent_warm"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRestTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_cream"
                android:textSize="26sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/brand_cream_alpha40">

                <View
                    android:id="@+id/restProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/brand_accent_warm"
                    android:transformPivotX="0dp" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnRestMore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/brand_cream_alpha40"
            android:contentDescription="Prodloužit pauzu o 30 sekund"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="+30 s"
            android:textColor="@color/brand_cream"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnRestSkip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ukončit pauzu"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_cream" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Deník úkolů: kompaktní karta uprostřed obrazovky (výška podle obsahu, ne přes celý displej).
    Dřív to byla dvoustránková kniha 150dp od okrajů – na telefonu úzké sloupce a spousta prázdna.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0B1206"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/journalPaperBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/aged_paper_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- Hlavička: kapitola, listování, zavření -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrevPage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/jersey_15"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/journal_ink"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chapterLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey_15"
                    android:letterSpacing="0.12"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:fontFamily="@font/jersey_15"
                    android:textColor="@color/journal_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnNextPage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/jersey_15"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/journal_ink"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/btnCloseJournal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/journal_ink" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.35"
            android:background="@color/journal_ink" />

        <!-- Fáze: portrét zadavatele + název + cíl -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npcPortrait"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="12dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chapterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey_15"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/taskListText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#33BC6C25"
                    android:fontFamily="@font/jersey_15"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="#9A5518"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/storyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/storyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jersey_15"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/journal_ink"
                android:textSize="16sp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.35"
            android:background="@color/journal_ink" />

        <!-- Postup: tečky + seznam fází (klepnutím se fáze zobrazí nahoře) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/jersey_15"
                android:text="Postup"
                android:textColor="@color/journal_chapter_title_ink"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/journalQuestProgressLine"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuestStagesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/jersey_15"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/journal_ink"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>

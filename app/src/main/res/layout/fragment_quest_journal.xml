<?xml version="1.0" encoding="utf-8"?>
<!--
    Deník úkolů jako rozevřená kniha v kožené vazbě. Výška se nastavuje v kódu
    (max. ~68 % obrazovky), dřív se kniha roztáhla skoro přes celý displej.
    Listování: šipky v rozích stránek, klepnutí na okraj stránky nebo tah prstem.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D90B1206"
    android:clickable="true"
    android:focusable="true">

    <!-- Záložky deníku: Příběh / Denní úkoly (docs/adr/0029) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <!-- záložky ve dvou řadách: zadní řada (Mapa, Spisy) vykukuje nad přední, jako rejstřík v sešitu -->
    <LinearLayout
        android:id="@+id/journalTabsBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-8dp"
        android:paddingStart="24dp"
        android:paddingEnd="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabZone"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#3F6B5A"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Mapa"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <!-- Sbírky (docs/adr/0060): chycení Makromoni, předměty, Makrodex -->
        <TextView
            android:id="@+id/tabPocket"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#6B4A8A"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Kapsa"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabBag"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#7A5428"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Batoh"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabDex"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#A23B3B"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Makrodex"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <!-- Spisy (docs/adr/0057): roztržené listy a hlášení o snech – záložka se ukáže až s prvním nálezem -->
        <TextView
            android:id="@+id/tabFiles"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#3A3A3A"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Spisy"
            android:textColor="#FEFAE0"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/journalTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabCharacter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#2E4677"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Postava"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabStory"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#BC6C25"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Příběh"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabDaily"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#606C38"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Denní"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabResources"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#9A5518"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Suroviny"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/tabAwards"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_journal_tab"
            android:backgroundTint="#8C6D1F"
            android:fontFamily="@font/jersey_15"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="6dp"
            android:text="Ocenění"
            android:textColor="#FEFAE0"
            android:textSize="17sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/journalBook"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:layout_marginTop="-6dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/journal_cover"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp"
        android:padding="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/journalPaperBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/aged_paper_bg">

            <!-- LEVÁ STRANA: příběh fáze -->
            <LinearLayout
                android:id="@+id/leftPage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="22dp"
                android:paddingBottom="40dp"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/bindingShadowContainer">

                <TextView
                    android:id="@+id/chapterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/jersey_15"
                    android:gravity="center"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="25sp" />

                <ImageView
                    android:id="@+id/npcPortrait"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/taskListText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#2EBC6C25"
                    android:fontFamily="@font/jersey_15"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:textColor="#9A5518"
                    android:textSize="16sp" />

                <ScrollView
                    android:id="@+id/storyScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadingEdgeLength="16dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/storyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey_15"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/journal_ink"
                        android:textSize="18sp" />
                </ScrollView>
            </LinearLayout>

            <!-- HŘBET -->
            <FrameLayout
                android:id="@+id/bindingShadowContainer"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/leftPage"
                app:layout_constraintEnd_toStartOf="@+id/rightPage">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/journal_spine_gradient" />
            </FrameLayout>

            <!-- PRAVÁ STRANA: postup a fáze -->
            <LinearLayout
                android:id="@+id/rightPage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:paddingTop="22dp"
                android:paddingBottom="40dp"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/bindingShadowContainer">

                <TextView
                    android:id="@+id/chapterLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey_15"
                    android:letterSpacing="0.1"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.75"
                    android:fontFamily="@font/jersey_15"
                    android:textColor="@color/journal_ink"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/jersey_15"
                    android:text="Postup úkolu"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="19sp" />

                <LinearLayout
                    android:id="@+id/journalQuestProgressLine"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/jersey_15"
                    android:text="Deník fází"
                    android:textColor="@color/journal_chapter_title_ink"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.6"
                    android:fontFamily="@font/jersey_15"
                    android:text="klepni na fázi a přečti si ji"
                    android:textColor="@color/journal_ink"
                    android:textSize="13sp" />

                <ScrollView
                    android:id="@+id/stagesScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <!-- fáze jako dřevěné řádky (docs/adr/0060), plní QuestJournalFragment -->
                    <LinearLayout
                        android:id="@+id/llQuestStages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp" />
                </ScrollView>
            </LinearLayout>

            <!-- Rohy stránek: listování -->
            <ImageView
                android:id="@+id/btnPrevPage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Předchozí kapitola"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/journal_chapter_title_ink" />

            <ImageView
                android:id="@+id/btnNextPage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Další kapitola"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/journal_chapter_title_ink" />
            <!-- DENNÍ ÚKOLY přes obě stránky (plní QuestJournalFragment) -->
            <ScrollView
                android:id="@+id/dailyPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llDaily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
            <!-- POSTAVA (docs/adr/0034): dovednosti a strom – plní JournalPages -->
            <FrameLayout
                android:id="@+id/characterPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- KAPSA (docs/adr/0060) -->
            <ScrollView
                android:id="@+id/pocketPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llPocket"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
            <!-- BATOH (docs/adr/0060) -->
            <ScrollView
                android:id="@+id/bagPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llBag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
            <!-- MAKRODEX (docs/adr/0060) -->
            <ScrollView
                android:id="@+id/dexPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llDex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
            <!-- SUROVINY (docs/adr/0034) -->
            <ScrollView
                android:id="@+id/resourcesPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llResources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <!-- OCENĚNÍ (docs/adr/0037) -->
            <ScrollView
                android:id="@+id/awardsPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llAwards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <!-- SPISY (docs/adr/0057) -->
            <ScrollView
                android:id="@+id/filesPage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/llFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <!-- MAPA (docs/adr/0052): záložky zón vlevo a mapa zóny, klepnutím teleport – plní QuestJournalFragment -->
            <FrameLayout
                android:id="@+id/zonePage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="3dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Záložka (stužka) přes horní hranu – jen přes kožený okraj desek, do textu nezasahuje
             (dřív byla 56 dp dlouhá a zakrývala text vpravo nahoře) -->
        <View
            android:layout_width="12dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-22dp"
            android:layout_marginEnd="54dp"
            android:background="#BC6C25"
            android:elevation="2dp" />

        <ImageButton
            android:id="@+id/btnCloseJournal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:elevation="3dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/journal_ink" />
    </FrameLayout>
    </LinearLayout>
</FrameLayout>

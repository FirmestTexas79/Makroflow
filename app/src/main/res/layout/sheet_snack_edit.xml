<?xml version="1.0" encoding="utf-8"?>
<!-- Nová / upravená potravina (docs/adr/0021): popsaná pole s jednotkami a živým výpočtem kcal. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_cream">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark_alpha20" />

    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:text="Nová potravina"
        android:textColor="@color/brand_dark"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tvEditSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:alpha="0.75"
        android:text="Hodnoty opiš z obalu – na porci, kterou obvykle sníš."
        android:textColor="@color/brand_primary"
        android:textSize="13sp" />

    <!-- Zdroje dat (jen u nové potraviny) -->
    <LinearLayout
        android:id="@+id/llEditSources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditBarcode"
            style="@style/ProfileToggleButton"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"
            android:text="ČÁROVÝ KÓD"
            android:textSize="11.5sp"
            app:icon="@drawable/ic_line_barcode"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/brand_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPhoto"
            style="@style/ProfileToggleButton"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"
            android:text="VYFOTIT (AI)"
            android:textSize="11.5sp"
            app:icon="@drawable/ic_line_camera"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/brand_dark" />
    </LinearLayout>

    <TextView style="@style/ProfileSection" android:layout_marginTop="18dp" android:text="POTRAVINA" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/ProfileField"
            android:layout_weight="2.2"
            android:layout_marginHorizontal="4dp"
            android:hint="Název">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                style="@style/ProfileFieldInput"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPortion"
                style="@style/ProfileField"
                android:layout_marginHorizontal="4dp"
                android:hint="Porce"
                app:suffixText="g">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPortion"
                    style="@style/ProfileFieldInput"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView style="@style/ProfileSection" android:layout_marginTop="18dp" android:text="MAKRA NA PORCI" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProtein"
                style="@style/ProfileField"
                android:layout_marginHorizontal="4dp"
                android:hint="Bílkoviny"
                app:suffixText="g">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProtein"
                    style="@style/ProfileFieldInput"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCarbs"
                style="@style/ProfileField"
                android:layout_marginHorizontal="4dp"
                android:hint="Sacharidy"
                app:suffixText="g">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCarbs"
                    style="@style/ProfileFieldInput"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFat"
                style="@style/ProfileField"
                android:layout_marginHorizontal="4dp"
                android:hint="Tuky"
                app:suffixText="g">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFat"
                    style="@style/ProfileFieldInput"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFiber"
                style="@style/ProfileField"
                android:layout_marginHorizontal="4dp"
                android:hint="Vláknina"
                app:suffixText="g">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFiber"
                    style="@style/ProfileFieldInput"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Živý výpočet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_stat_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <cz.uhk.macroflow.nutrition.MacroDonutView
            android:id="@+id/donutEdit"
            android:layout_width="40dp"
            android:layout_height="40dp" />
        <TextView
            android:id="@+id/tvEditKcal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/brand_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView style="@style/ProfileSection" android:layout_marginTop="18dp" android:text="KDY SE HODÍ" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleEditTiming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPre"
            style="@style/ProfileToggleButton"
            android:text="PŘED TRÉNINKEM"
            android:textSize="11.5sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPost"
            style="@style/ProfileToggleButton"
            android:text="PO TRÉNINKU"
            android:textSize="11.5sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditSave"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/brand_dark"
        android:fontFamily="sans-serif-black"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Uložit do špajzky"
        android:textColor="@color/brand_cream"
        android:textSize="15sp"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconTint="@color/brand_cream" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Aréna (docs/adr/0076): tvůj tým jako duch, AI trenéři a duchové ostatních hráčů. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="150dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.16"
            android:text="MAKROSVĚT"
            android:textColor="@color/brand_accent_deep"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/jersey_15"
            android:text="Aréna"
            android:textColor="@color/brand_dark"
            android:textSize="46sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:alpha="0.75"
            android:text="Souboje s trenéry. Tvůj tým tu hájí arénu jako duch, i když zrovna nehraješ."
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />

        <!-- ═══ TVŮJ TÝM ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_arena_hero"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="TVŮJ TÝM"
                        android:textColor="@color/brand_accent_warm"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvArenaName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/jersey_15"
                        android:text="Trenér ✎"
                        android:textColor="@color/brand_cream"
                        android:textSize="28sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvArenaPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey_15"
                        android:text="⚔ 0"
                        android:textColor="@color/brand_cream"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvArenaRecord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="0 výher · 0 proher"
                        android:textColor="@color/brand_cream"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMyTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tvGhostStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/brand_cream_alpha15"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textColor="@color/brand_cream"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ═══ AI TRENÉŘI ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.16"
            android:text="TRENÉŘI ARÉNY · DNES"
            android:textColor="@color/brand_accent_deep"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llAiTrainers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ═══ DUCHOVÉ HRÁČŮ ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.16"
            android:text="DUCHOVÉ HRÁČŮ"
            android:textColor="@color/brand_accent_deep"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llGhosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvGhostsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_arena_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="Načítám duchy…"
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

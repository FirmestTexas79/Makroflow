<?xml version="1.0" encoding="utf-8"?>
<!--
    Snacky (docs/adr/0021): hlavička s dnešním zůstatkem, hledání a filtr před/po tréninku
    se při scrollu schová a při návratu vyjede; seznam je RecyclerView po skupinách
    (Oblíbené, Bílkoviny, Sacharidy, Tuky). Jediné plovoucí tlačítko „Přidat“ otevře nabídku
    (ručně, čárový kód, fotka, složit jídlo, swipe).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snackRoot"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-70dp"
        android:alpha="0.07"
        android:importantForAccessibility="no"
        android:rotation="-30"
        android:src="@drawable/bg_monstera_leaf_1"
        app:tint="@color/brand_dark" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/snackAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <TextView
                android:id="@+id/tvSnackBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/brand_accent_warm"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="MAKRO ŠPAJZKA"
                android:textColor="@color/brand_cream"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSnackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="0.9"
                android:text="Snacky"
                android:textColor="@color/brand_dark"
                android:textSize="40sp" />

            <!-- Dnešní zůstatek – pomáhá vybrat, co se ještě vejde -->
            <TextView
                android:id="@+id/tvSnackSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:text="Klepni na potravinu a přidej ji do dnešního dne"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/brand_primary" />

                <EditText
                    android:id="@+id/etSnackSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Hledej potravinu (třeba „kure“)"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/brand_dark"
                    android:textColorHint="@color/brand_dark_alpha40"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivClearSearch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Smazat hledání"
                    android:padding="11dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/brand_dark" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleSnackTiming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:checkedButton="@+id/btnTimingAll"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimingAll"
                    style="@style/ProfileToggleButton"
                    android:layout_height="42dp"
                    android:text="VŠE"
                    android:layout_weight="0.6"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="4dp"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreWorkout"
                    style="@style/ProfileToggleButton"
                    android:layout_height="42dp"
                    android:text="PŘED TRÉNINKEM"
                    android:layout_weight="1.3"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="4dp"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostWorkout"
                    style="@style/ProfileToggleButton"
                    android:layout_height="42dp"
                    android:text="PO TRÉNINKU"
                    android:layout_weight="1.1"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="4dp"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSnacks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="200dp" />

        <!-- Nic nenalezeno -->
        <LinearLayout
            android:id="@+id/snackEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="48dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSnackEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nic takového ve špajzce není."
                android:textColor="@color/brand_dark"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyCreate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Vytvořit potravinu"
                app:icon="@drawable/ic_line_plus" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddSnack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="108dp"
        android:fontFamily="sans-serif-black"
        android:text="Přidat"
        android:textColor="@color/brand_cream"
        android:textSize="13sp"
        app:backgroundTint="@color/brand_dark"
        app:elevation="6dp"
        app:icon="@drawable/ic_line_plus"
        app:iconTint="@color/brand_cream"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LargeComponent.Rounded" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/mapMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/mapBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/poketown" />

        <ImageView
            android:id="@+id/ashView"
            android:layout_width="28dp"
            android:layout_height="42dp"
            android:scaleType="fitCenter"
            android:elevation="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="60dp"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:elevation="15dp">

            <TextView android:id="@+id/tvCompanionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FEFAE0" android:fontFamily="sans-serif-black" android:visibility="gone" />

            <FrameLayout android:layout_width="100dp" android:layout_height="100dp" android:layout_marginTop="4dp">
                <View android:id="@+id/companionShadow" android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center" android:background="@drawable/bg_status_pill" android:backgroundTint="#606C38" android:alpha="0.45" android:visibility="gone" />
                <ImageView android:id="@+id/ivCompanion" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:elevation="15dp">
            <ImageButton android:id="@+id/btnExitMap" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#283618" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="#FEFAE0" />
            <ImageButton android:id="@+id/btnStartTutorial" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#606C38" android:src="@android:drawable/ic_menu_help" app:tint="#FEFAE0" />

            <ImageButton
                android:id="@+id/btnOpenJournal"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="-8dp"
                android:layout_marginRight="-4dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu_book" />

        </LinearLayout>

        <cz.uhk.macroflow.pokemon.ui.StepProgressBar
            android:id="@+id/stepProgressBar"
            android:layout_width="140dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            android:elevation="15dp" />

        <FrameLayout
            android:id="@+id/mapFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="50dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tutorialOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="100dp">

        <LinearLayout
            android:id="@+id/tutorialDialogBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/macroflow_dialog_bg"
            android:orientation="vertical"
            android:paddingStart="126dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:elevation="105dp">

            <TextView
                android:id="@+id/tutorialSpeakerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#283618"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/questProgressLine"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/questStageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#606C38"
                android:fontFamily="sans-serif-medium"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tutorialText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#283618"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tutorialTeacher"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="16dp"
            android:elevation="115dp"
            android:scaleType="fitCenter" />
    </FrameLayout>
</FrameLayout>
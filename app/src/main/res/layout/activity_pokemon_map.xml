<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:id="@+id/mapMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/mapBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/poketown" />

        <FrameLayout android:id="@+id/townHotspots" android:layout_width="match_parent" android:layout_height="match_parent" />
        <FrameLayout android:id="@+id/meadowHotspots" android:layout_width="match_parent" android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/ashView"
            android:layout_width="28dp"
            android:layout_height="42dp"
            android:scaleType="fitCenter"
            android:elevation="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="60dp"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:elevation="15dp">
            <TextView android:id="@+id/tvCompanionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FEFAE0" android:fontFamily="sans-serif-black" android:visibility="gone" />
            <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="4dp">
                <View android:id="@+id/companionShadow" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="center" android:background="@drawable/bg_status_pill" android:backgroundTint="#606C38" android:alpha="0.45" android:visibility="gone" />
                <ImageView android:id="@+id/ivCompanion" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:elevation="15dp">
            <ImageButton android:id="@+id/btnExitMap" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#283618" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="#FEFAE0" />
            <ImageButton android:id="@+id/btnStartTutorial" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_status_pill" android:backgroundTint="#606C38" android:src="@android:drawable/ic_menu_help" app:tint="#FEFAE0" />
        </LinearLayout>

        <!-- Progress bar vpravo uprostřed (v ose Y) -->
        <cz.uhk.macroflow.pokemon.ui.StepProgressBar
            android:id="@+id/stepProgressBar"
            android:layout_width="140dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            android:elevation="15dp" />

        <FrameLayout android:id="@+id/mapFragmentContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:elevation="20dp" />
    </RelativeLayout>

    <FrameLayout android:id="@+id/tutorialOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:elevation="100dp">
        <ImageView android:id="@+id/tutorialTeacher" android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="bottom|start" android:layout_marginBottom="150dp" android:layout_marginStart="10dp" android:elevation="110dp" />
        <LinearLayout android:id="@+id/tutorialDialogBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="20dp" android:background="@drawable/macroflow_dialog_bg" android:orientation="vertical" android:padding="20dp" android:elevation="105dp">
            <TextView android:id="@+id/tutorialSpeakerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_accent_deep" android:fontFamily="sans-serif-black" android:textSize="14sp" />
            <TextView android:id="@+id/tutorialText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/brand_dark" android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
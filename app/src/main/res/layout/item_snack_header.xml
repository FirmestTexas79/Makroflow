<?xml version="1.0" encoding="utf-8"?>
<!-- Oddíl seznamu Snacků: kategorie (docs/adr/0073) s ikonou, názvem a počtem potravin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvHeaderEmoji"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_status_pill"
        android:gravity="center"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvSnackHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/brand_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHeaderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/brand_dark_alpha10"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <View
        android:id="@+id/headerLine"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_status_pill" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Profil (záložka PROFIL), přepracováno v docs/adr/0075: souhrnná karta (kdo jsem, míry, denní cíl)
    a tři seskupené karty – Tělo, Cíl a aktivita, Účet. Jazyk je stejný jako hlavní obrazovka (0074).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0.07"
        android:rotation="-15"
        android:src="@drawable/bg_monstera_leaf_1"
        app:tint="@color/brand_dark" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="190dp">

        <LinearLayout
            android:id="@+id/setupMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp">

            <!-- ═══ HLAVIČKA ═══ -->
            <TextView
                android:id="@+id/tvProfileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.16"
                android:text="@string/setup_badge_profile"
                android:textColor="@color/brand_accent_deep"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/setup_title"
                android:textColor="@color/brand_dark"
                android:textSize="34sp" />

            <!-- ═══ SOUHRN ═══ -->
            <FrameLayout
                android:id="@+id/cardProfileHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dash_hero"
                android:clipChildren="true"
                android:elevation="6dp"
                android:outlineProvider="background">

                <View
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-110dp"
                    android:layout_marginEnd="-90dp"
                    android:background="@drawable/bg_dash_hero_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- kdo jsem -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeroInitial"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_profile_avatar"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="@color/brand_cream"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHeroName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:text="Makroflow"
                                android:textColor="@color/brand_cream"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvHeroSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.65"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/brand_cream"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHeroGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="@color/brand_accent_warm"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="UDRŽENÍ"
                            android:textColor="@color/brand_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- míry -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="#14FEFAE0"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <LinearLayout style="@style/ProfStatCol">
                            <TextView android:id="@+id/tvHeroWeight" style="@style/ProfStatValue" android:text="—" />
                            <TextView style="@style/ProfStatLabel" android:text="KG" />
                        </LinearLayout>

                        <View style="@style/ProfStatDivider" />

                        <LinearLayout style="@style/ProfStatCol">
                            <TextView android:id="@+id/tvHeroHeight" style="@style/ProfStatValue" android:text="—" />
                            <TextView style="@style/ProfStatLabel" android:text="CM" />
                        </LinearLayout>

                        <View style="@style/ProfStatDivider" />

                        <LinearLayout style="@style/ProfStatCol">
                            <TextView android:id="@+id/tvHeroAge" style="@style/ProfStatValue" android:text="—" />
                            <TextView style="@style/ProfStatLabel" android:text="LET" />
                        </LinearLayout>

                        <View style="@style/ProfStatDivider" />

                        <LinearLayout style="@style/ProfStatCol">
                            <TextView android:id="@+id/tvHeroBmi" style="@style/ProfStatValue" android:text="—" />
                            <TextView style="@style/ProfStatLabel" android:text="BMI" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- denní cíl -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:layout_weight="1"
                            android:letterSpacing="0.14"
                            android:text="@string/profile_hero_label"
                            android:textColor="@color/brand_accent_warm"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroKcal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="— kcal"
                            android:textColor="@color/brand_cream"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/heroBarProtein"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="#B5CC8E" />

                        <View
                            android:id="@+id/heroBarCarbs"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="#E9B072" />

                        <View
                            android:id="@+id/heroBarFat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="#E5824A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/tvHeroProtein" style="@style/ProfHeroMacro" android:drawableStart="@drawable/dash_dot_p" android:text="Bílkoviny —" />
                        <TextView android:id="@+id/tvHeroCarbs" style="@style/ProfHeroMacro" android:drawableStart="@drawable/dash_dot_c" android:text="Sacharidy —" />
                        <TextView android:id="@+id/tvHeroFat" style="@style/ProfHeroMacro" android:drawableStart="@drawable/dash_dot_f" android:text="Tuky —" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ═══ TĚLO ═══ -->
            <TextView style="@style/ProfGroupTitle" android:text="@string/setup_section_basic" />

            <LinearLayout style="@style/ProfGroupCard">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMale"
                        style="@style/ProfileToggleButton"
                        android:text="@string/man" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFemale"
                        style="@style/ProfileToggleButton"
                        android:text="@string/woman" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/DashMetricBox">
                        <TextView style="@style/DashMetricLabel" android:text="VÁHA" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <EditText android:id="@+id/etWeight" style="@style/ProfMetricInput" android:hint="0" />
                            <TextView style="@style/DashMetricUnit" android:text="kg" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/DashMetricBox" android:layout_marginHorizontal="8dp">
                        <TextView style="@style/DashMetricLabel" android:text="VÝŠKA" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <EditText android:id="@+id/etHeight" style="@style/ProfMetricInput" android:hint="0" />
                            <TextView style="@style/DashMetricUnit" android:text="cm" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/DashMetricBox">
                        <TextView style="@style/DashMetricLabel" android:text="VĚK" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <EditText android:id="@+id/etAge" style="@style/ProfMetricInput" android:hint="0" android:inputType="number" android:maxLength="3" />
                            <TextView style="@style/DashMetricUnit" android:text="let" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/ProfDivider" />

                <LinearLayout android:id="@+id/cardOptionalMetrics" style="@style/ProfRow">
                    <TextView style="@style/ProfRowIcon" android:text="📏" />
                    <LinearLayout style="@style/ProfileOptionTexts">
                        <TextView style="@style/ProfileOptionTitle" android:text="@string/profile_metrics_title" />
                        <TextView style="@style/ProfileOptionSub" android:text="@string/profile_metrics_sub" />
                    </LinearLayout>
                    <ImageView style="@style/ProfRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ CÍL A AKTIVITA ═══ -->
            <TextView style="@style/ProfGroupTitle" android:text="@string/profile_section_goal" />

            <LinearLayout style="@style/ProfGroupCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/btnCut" style="@style/ProfGoalTile">
                        <TextView style="@style/ProfGoalEmoji" android:text="📉" />
                        <TextView style="@style/ProfGoalTitle" android:text="@string/profile_goal_cut" />
                        <TextView style="@style/ProfGoalSub" android:text="CUT" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnMaintain" style="@style/ProfGoalTile" android:layout_marginHorizontal="8dp">
                        <TextView style="@style/ProfGoalEmoji" android:text="⚖️" />
                        <TextView style="@style/ProfGoalTitle" android:text="@string/profile_goal_maintain" />
                        <TextView style="@style/ProfGoalSub" android:text="MAINTAIN" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnBulk" style="@style/ProfGoalTile">
                        <TextView style="@style/ProfGoalEmoji" android:text="📈" />
                        <TextView style="@style/ProfGoalTitle" android:text="@string/profile_goal_bulk" />
                        <TextView style="@style/ProfGoalSub" android:text="BULK" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/ProfDivider" />

                <TextView style="@style/DashMetricLabel" android:layout_marginStart="4dp" android:layout_marginBottom="6dp" android:text="@string/setup_section_lifestyle" />

                <LinearLayout android:id="@+id/clickLezerni" style="@style/ProfileOptionRow">
                    <ImageView style="@style/ProfileOptionIcon" android:src="@drawable/ic_ls_desk" />
                    <LinearLayout style="@style/ProfileOptionTexts">
                        <TextView style="@style/ProfileOptionTitle" android:text="@string/profile_ls_low" />
                        <TextView style="@style/ProfileOptionSub" android:text="@string/profile_ls_low_sub" />
                    </LinearLayout>
                    <ImageView android:id="@+id/checkLezerni" style="@style/ProfileOptionCheck" />
                </LinearLayout>

                <LinearLayout android:id="@+id/clickAktivni" style="@style/ProfileOptionRow">
                    <ImageView style="@style/ProfileOptionIcon" android:src="@drawable/ic_ls_walk" />
                    <LinearLayout style="@style/ProfileOptionTexts">
                        <TextView style="@style/ProfileOptionTitle" android:text="@string/profile_ls_mid" />
                        <TextView style="@style/ProfileOptionSub" android:text="@string/profile_ls_mid_sub" />
                    </LinearLayout>
                    <ImageView android:id="@+id/checkAktivni" style="@style/ProfileOptionCheck" />
                </LinearLayout>

                <LinearLayout android:id="@+id/clickSportovec" style="@style/ProfileOptionRow">
                    <ImageView style="@style/ProfileOptionIcon" android:src="@drawable/ic_ls_lift" />
                    <LinearLayout style="@style/ProfileOptionTexts">
                        <TextView style="@style/ProfileOptionTitle" android:text="@string/profile_ls_high" />
                        <TextView style="@style/ProfileOptionSub" android:text="@string/profile_ls_high_sub" />
                    </LinearLayout>
                    <ImageView android:id="@+id/checkSportovec" style="@style/ProfileOptionCheck" />
                </LinearLayout>

                <View style="@style/ProfDivider" />

                <LinearLayout
                    android:id="@+id/cardStepGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/DashMetricLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setup_label_steps" />

                    <TextView
                        android:id="@+id/tvStepGoalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill"
                        android:backgroundTint="@color/brand_primary_alpha10"
                        android:fontFamily="sans-serif-black"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/setup_steps_default"
                        android:textColor="@color/brand_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStepGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="500"
                    android:value="6000"
                    android:valueFrom="2000"
                    android:valueTo="20000"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/brand_primary"
                    app:tickVisible="false"
                    app:trackColorActive="@color/brand_primary"
                    app:trackColorInactive="@color/brand_dark_alpha12" />
            </LinearLayout>

            <!-- ═══ ÚČET ═══ -->
            <TextView style="@style/ProfGroupTitle" android:text="@string/setup_section_account" />

            <LinearLayout android:id="@+id/cardAccountInfo" style="@style/ProfGroupCard" android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView style="@style/ProfRowIcon" android:text="☁️" />

                    <LinearLayout style="@style/ProfileOptionTexts">
                        <TextView
                            android:id="@+id/tvUserEmail"
                            style="@style/ProfileOptionTitle"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/setup_offline_mode" />
                        <TextView android:id="@+id/tvSyncStatus" style="@style/ProfileOptionSub" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/ProfDivider" android:layout_marginVertical="4dp" />

                <LinearLayout android:id="@+id/btnSignOut" style="@style/ProfRow">
                    <ImageView style="@style/ProfRowIconImg" android:src="@drawable/ic_nav_logout" />
                    <TextView android:id="@+id/tvSignOut" style="@style/ProfRowTitle" android:text="@string/setup_btn_login" />
                    <ImageView style="@style/ProfRowChevron" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnDeleteAccount" style="@style/ProfRow">
                    <ImageView style="@style/ProfRowIconImg" android:backgroundTint="#1AB3261E" android:src="@drawable/ic_delete" app:tint="?attr/colorError" />
                    <TextView style="@style/ProfRowTitle" android:text="@string/profile_delete_account" android:textColor="?attr/colorError" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:alpha="0.45"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/brand_dark"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="112dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_save"
        android:textColor="@color/brand_cream"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_dark"
        app:cornerRadius="28dp"
        app:elevation="10dp"
        app:icon="@drawable/ic_save"
        app:iconSize="22dp"
        app:iconTint="@color/brand_cream" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

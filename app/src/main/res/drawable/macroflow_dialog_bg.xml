<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vnější tmavý border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#283618" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Světlý vnitřní okraj (mezera) -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FEFAE0" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Druhý tmavý rámeček uvnitř -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#283618" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Hlavní světlé pozadí -->
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#FEFAE0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
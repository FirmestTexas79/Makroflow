<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Makroflow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <item name="colorOnSecondary">@color/brand_cream</item>
        <!-- Kremové pozadí — žádný černý záblesk při startu -->
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/brand_dark</item>
        <item name="colorTertiary">@color/brand_accent_warm</item>
        <item name="colorOnTertiary">@color/brand_dark</item>
        <!-- Úplná paleta rolí Material 3 v barvách aplikace. Dřív chyběly „container“,
             „surface“ a „outline“ role → komponenty braly výchozí fialovou (výběr v draweru,
             přepínač pohlaví, dialogy, oddělovače). -->
        <item name="colorPrimaryContainer">#DDE5C0</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondaryContainer">#E4E6C8</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorTertiaryContainer">#F6DDBF</item>
        <item name="colorOnTertiaryContainer">@color/brand_dark</item>
        <item name="colorSurfaceVariant">#EFEBD3</item>
        <item name="colorOnSurfaceVariant">@color/brand_primary</item>
        <item name="colorOutline">#B9B596</item>
        <item name="colorOutlineVariant">#E2DDC4</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FCF8E6</item>
        <item name="colorSurfaceContainer">#F7F3DD</item>
        <item name="colorSurfaceContainerHigh">#F2EED6</item>
        <item name="colorSurfaceContainerHighest">#ECE8CF</item>
        <item name="colorError">#A63D2A</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">#F6D9CF</item>
        <item name="colorOnErrorContainer">#5A1A0E</item>
    </style>

    <style name="Theme.Makroflow" parent="Base.Theme.Makroflow">
        <!-- Status bar řízen programově v MainActivity.hideStatusBar() -->
        <!-- windowTranslucentStatus=false aby hideStatusBar() fungoval správně -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/brand_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="PillShape">
        <item name="cornerSize">25dp</item>
    </style>

    <style name="MacroflowCalendarTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_accent_deep</item>
        <item name="colorOnSurface">@color/brand_dark</item>
        <item name="colorOnSurfaceVariant">@color/brand_primary</item>
    </style>

</resources>
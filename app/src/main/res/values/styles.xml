<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DrawerItemText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand_dark</item>
    </style>

    <style name="BottomNavText" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="BottomNavText.Active" parent="BottomNavText">
    </style>

    <style name="BottomNavText.Inactive" parent="BottomNavText">
    </style>

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogContent</item>
    </style>

    <style name="CustomAlertDialogContent" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="backgroundTint">@color/brand_cream</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LargeComponent.Rounded</item>
    </style>

    <style name="ShapeAppearance.LargeComponent.Rounded" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>
    <!-- Přepínač záložek v Makrodexu (Makrodex / shiny viděno / shiny chyceno) -->
    <style name="MakrodexChip">
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:backgroundTint">@color/brand_primary_alpha10</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ═══ Profil (docs/adr/0018) ═══ -->
    <style name="ProfileSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableStart">@drawable/section_line</item>
        <item name="android:drawableEnd">@drawable/section_line</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="ProfileCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cardBackgroundColor">@color/profile_card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/brand_dark_alpha12</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ProfileMacroChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:textColor">@color/brand_cream</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/profile_toggle_bg</item>
        <item name="android:textColor">@color/profile_toggle_text</item>
        <item name="strokeColor">@color/brand_primary_alpha30</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="ProfileField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="suffixTextColor">@color/brand_primary</item>
    </style>

    <style name="ProfileFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileGoalButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="strokeColor">@color/brand_dark_alpha12</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ProfileOptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">2dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_option_idle</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ProfileOptionIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:backgroundTint">@color/brand_primary_alpha10</item>
        <item name="tint">@color/brand_dark</item>
    </style>

    <style name="ProfileOptionTexts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ProfileOptionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProfileOptionSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:alpha">0.8</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ProfileOptionCheck">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_check_circle</item>
        <item name="tint">@color/brand_primary</item>
        <item name="android:visibility">invisible</item>
    </style>
    <!-- Nadpis sekce v „Jdu na trénink“ (docs/adr/0065) -->
    <style name="QwSection">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/brand_accent_deep</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Hlavní obrazovka (docs/adr/0074) -->
    <style name="DashMacroCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="DashMacroLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">#B3FEFAE0</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DashMacroValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/brand_cream</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DashMacroLeft">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textColor">#99FEFAE0</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="DashTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DashTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="DashMetricBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_dash_metric</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="DashMetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DashMetricInput">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:maxLength">5</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textColorHint">@color/brand_dark_alpha30</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="DashMetricUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:alpha">0.55</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DashPctLegend">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Profil (docs/adr/0075) -->
    <style name="ProfStatCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="ProfStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/brand_cream</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="ProfStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">#8CFEFAE0</item>
